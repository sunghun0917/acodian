# EC2 배포용 환경변수 예시.
# 서버마다 `/opt/axwms/{staging|production}/.env` 로 복사해 실제 값을 채운다.
# 이 파일은 샘플만 제공하며, 실제 비밀값은 절대 커밋하지 않는다.

APP_ENV=staging
API_HOST_PORT=8081

# --- DB ---
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
