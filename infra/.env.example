# compose.deploy.yml 에서 참조하는 환경변수 샘플.
# 이 값들은 `infra_validate` 의 compose config 렌더와 로컬 스모크 테스트에서
# 그대로 동작하도록 채워 둔 "스모크 테스트용 기본값" 일 뿐, 프로덕션에서는 절대 사용하지 않는다.
# 환경 특화 값(APP_ENV, API_HOST_PORT, API_IMAGE 등) 과 실제 비밀값은
# 이 파일에 두지 않고 EC2 `/opt/axwms/{staging|production}/.env` 또는 GitLab CI/CD Variables 로만 주입한다.
# 정책 근거: ADR-003 / ADR-009.

# --- DB ---
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
# HMAC-SHA256 이 요구하는 최소 32바이트를 만족하는 스모크 테스트용 값. 프로덕션 절대 금지.
JWT_SECRET=smoke-test-secret-change-me-please-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# --- AI (Gemini) ---
# 실제 키는 EC2 `.env` 또는 GitLab CI/CD Variables 로만 주입한다 (GEN-002 / ADR-003).
# 아래 값은 compose 렌더 / `infra_validate` / 로컬 스모크가 깨지지 않게 하는 더미일 뿐이며,
# Gemini 호출이 실제로 실행되면 401/403 으로 실패한다(의도된 동작).
GEMINI_API_KEY=smoke-test-gemini-key-not-real
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
CHUNK_THRESHOLD_CHARS=3000
AI_LOG_LEVEL=INFO

# --- Storage (S3) ---
# 실제 값은 EC2 `.env` 또는 GitLab CI/CD Variables 로만 주입한다.
AWS_S3_BUCKET=smoke-test-bucket-not-real
AWS_REGION=ap-northeast-2
AWS_S3_BASE_PREFIX=ax-wms
AWS_S3_PUBLIC_BASE_URL=https://example-bucket.s3.ap-northeast-2.amazonaws.com
AWS_ACCESS_KEY_ID=smoke-test-access-key-not-real
AWS_SECRET_ACCESS_KEY=smoke-test-secret-key-not-real

# --- Profile image cleanup (api 스케줄러) ---
# cron 은 Spring 6필드(sec min hour day month dow). 컨테이너 TZ=Asia/Seoul 기준.
# 호스트 환경의 `TZ` 변수와 충돌을 피하려 api 컨테이너 TZ 호스트 키는 `API_TZ` 로 둔다.
API_TZ=Asia/Seoul
PROFILE_IMAGE_CLEANUP_CRON=0 20 22 * * *
PROFILE_IMAGE_TEMP_PREFIX=temp/
PROFILE_IMAGE_RETENTION_DAYS=1
