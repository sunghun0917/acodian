# infra/compose.deploy.yml 에서 참조하는 환경변수 샘플.
# 실제 배포 전 `cp .env.example .env` 후 값을 조정한다.
# 이 파일은 스모크 테스트용 기본값이며 프로덕션에서는 절대 사용하지 않는다.

# --- DB ---
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT (smoke test only; rotate before real use) ---
JWT_SECRET=smoke-test-secret-change-me-please-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
