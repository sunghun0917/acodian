# compose.deploy.yml 에서 참조하는 환경변수 샘플.
# 이 값들은 `infra_validate` 의 compose config 렌더와 로컬 스모크 테스트에서
# 그대로 동작하도록 채워 둔 "스모크 테스트용 기본값" 일 뿐, 프로덕션에서는 절대 사용하지 않는다.
# 환경 특화 값(APP_ENV, API_HOST_PORT, API_IMAGE 등) 과 실제 비밀값은
# 이 파일에 두지 않고 EC2 `/opt/axwms/{staging|production}/.env` 또는 GitLab CI/CD Variables 로만 주입한다.
# 정책 근거: ADR-003 / ADR-009.

# --- DB ---
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
# HMAC-SHA256 이 요구하는 최소 32바이트를 만족하는 스모크 테스트용 값. 프로덕션 절대 금지.
JWT_SECRET=smoke-test-secret-change-me-please-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
