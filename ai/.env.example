APP_NAME=AX-WMS AI Service
APP_VERSION=0.1.0
ENVIRONMENT=local
API_PREFIX=/ai
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
CHUNK_THRESHOLD_CHARS=3000

API_BASE_URL=http://localhost:8100
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/axwms
REDIS_URL=redis://localhost:6379/0

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-local-password

LIGHTRAG_WORKING_DIR=./data/lightrag-v3
LIGHTRAG_LLM_MODEL=gemini-2.5-flash
LIGHTRAG_EMBEDDING_MODEL=gemini-embedding-001
LIGHTRAG_LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
LIGHTRAG_QUERY_LLM_MAX_RETRIES_PER_MODEL=2
LIGHTRAG_QUERY_LLM_RETRY_INITIAL_DELAY_SECONDS=0.5
LIGHTRAG_QUERY_LLM_RETRY_MAX_DELAY_SECONDS=4.0
LIGHTRAG_EMBEDDING_MAX_TOKEN_SIZE=2048
LIGHTRAG_INDEX_MAX_BATCH_SIZE=10
LIGHTRAG_INSERT_TIMEOUT_SECONDS=120
LIGHTRAG_KG_LANGUAGE=Korean
LIGHTRAG_WORKSPACE=


# LightRAG Qdrant vector store
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_QDRANT_URL=http://localhost:6333
LIGHTRAG_QDRANT_API_KEY=

# LightRAG Neo4j graph store
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_NEO4J_DATABASE=neo4j

# LightRAG query API
LIGHTRAG_QUERY_TIMEOUT_SECONDS=120
LIGHTRAG_QUERY_TOP_K=40
LIGHTRAG_QUERY_CHUNK_TOP_K=20
LIGHTRAG_QUERY_RESPONSE_TYPE=Multiple Paragraphs

# Worklog detail links used in LightRAG query answers
WORKLOG_DETAIL_BASE_URL=https://k14s209.p.ssafy.io:8443/worklog/detail
