# 브라우저에서 사용할 API 서버 주소입니다.
# NEXT_PUBLIC_ prefix가 있어야 Next.js 클라이언트 코드에서 접근할 수 있습니다.
#
# 배포(staging/production)에서는 비워 두면 됩니다 — web 컨테이너와 API 컨테이너가
# 같은 nginx 뒤에 있고, nginx 가 동일 origin 의 `/api/` 를 각 환경의 API 컨테이너로
# 라우팅하므로 axios 가 기본값 `/api` 로 자동 동작합니다.
# (infra/nginx/sites-available/axwms.conf 참고)
#
# 로컬 개발에서 web(:3000)이 다른 host 의 API(:8100)를 직접 부르고 싶을 때만
# 아래처럼 절대 URL 을 지정합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100/api

# Playwright E2E는 기본 명령(`pnpm e2e`, `pnpm e2e:ui`)으로 실제 API를 호출합니다.
# 원격 API CORS 허용 origin과 맞추기 위해 기본 host는 localhost입니다. 필요할 때만 변경하세요.
WEB_E2E_HOST=localhost
# 비밀번호는 저장소에 커밋하지 말고 로컬 .env 또는 CI secret으로만 주입하세요.
WEB_E2E_DIRECTOR_EMAIL=director@ibank.local
WEB_E2E_DIRECTOR_PASSWORD=password1!
WEB_E2E_DEPT_HEAD_EMAIL=u002@ibank.local
WEB_E2E_DEPT_HEAD_PASSWORD=password1!
WEB_E2E_TEAM_LEAD_EMAIL=u035@ibank.local
WEB_E2E_TEAM_LEAD_PASSWORD=password1!
WEB_E2E_MEMBER_EMAIL=u033@ibank.local
WEB_E2E_MEMBER_PASSWORD=password1!
