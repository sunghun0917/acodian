# 브라우저에서 사용할 API 서버 주소입니다.
# NEXT_PUBLIC_ prefix가 있어야 Next.js 클라이언트 코드에서 접근할 수 있습니다.
#
# 배포(staging/production)에서는 비워 두면 됩니다 — web 컨테이너와 API 컨테이너가
# 같은 nginx 뒤에 있고, nginx 가 동일 origin 의 `/api/` 를 각 환경의 API 컨테이너로
# 라우팅하므로 axios 가 기본값 `/api` 로 자동 동작합니다.
# (infra/nginx/sites-available/axwms.conf 참고)
#
# 로컬 개발에서 web(:3000)이 다른 host 의 API(:8100)를 직접 부르고 싶을 때만
# 아래처럼 절대 URL 을 지정합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100/api
