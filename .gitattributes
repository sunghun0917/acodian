# 기본 원칙: 텍스트 파일은 LF로 통일
* text=auto

# 문서
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.conf text eol=lf
*.ini text eol=lf
# 애플리케이션 소스
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.gradle text eol=lf
# 셸/도구 스크립트
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
# 플랫폼별 예외
*.bat text eol=crlf
*.cmd text eol=crlf
# 바이너리
*.docx binary
*.jar binary
*.bin binary
*.gif filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
